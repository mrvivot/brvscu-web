---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  title: string;
  description?: string;
  /** Slug de la página sin locale, ej. "" para Home, "areas" para Áreas de práctica */
  path?: string;
}

const {
  title,
  description = "Estudio jurídico BRVSCU. Asesoramiento legal para empresas y personas en civil, comercial, laboral, penal y más.",
  path = "",
} = Astro.props;

const currentLocale = Astro.currentLocale ?? "es";
const siteUrl = "https://brvscu.com.ar";
const esPath = getRelativeLocaleUrl("es", path);
const enPath = getRelativeLocaleUrl("en", path);
const canonicalPath = currentLocale === "en" ? enPath : esPath;
---

<!DOCTYPE html>
<html lang={currentLocale}>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Microsoft Clarity -->
  <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xu64tjckqd");
  </script>

  <!-- Hreflang -->
  <link rel="canonical" href={siteUrl + canonicalPath} />
  <link rel="alternate" href={siteUrl + esPath} hreflang="es" />
  <link rel="alternate" href={siteUrl + enPath} hreflang="en" />
  <link rel="alternate" href={siteUrl + esPath} hreflang="x-default" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={siteUrl + canonicalPath} />
  <meta property="og:site_name" content={currentLocale === "en" ? "BRVSCU Law Firm" : "BRVSCU Abogados"} />
  <meta property="og:locale" content={currentLocale === "en" ? "en_US" : "es_AR"} />
  <meta property="og:locale:alternate" content={currentLocale === "en" ? "es_AR" : "en_US"} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Datos estructurados (schema.org) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LegalService",
    "name": "BRVSCU Abogados",
    "alternateName": "Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu",
    "url": "https://brvscu.com.ar",
    "telephone": "+541145198173",
    "email": "secretaria@brvscu.com.ar",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Avda. Santa Fe 1752, 1º A",
      "addressLocality": "Ciudad de Buenos Aires",
      "postalCode": "C1060ABQ",
      "addressCountry": "AR"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    "sameAs": [
      "https://www.linkedin.com/company/berdaguer-rojo-vivot-silvero-canziani-uriburu-abogados/"
    ]
  })} />

  <!-- Bootstrap CSS (primero) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

  <!-- Tu CSS (después de Bootstrap para poder sobrescribir) -->
  <link rel="stylesheet" href="/styles.css">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>

<body class={path === "" ? "" : "subpage"}>
  <a href="#main-content" class="skip-link">{currentLocale === "en" ? "Skip to content" : "Saltar al contenido"}</a>
  <slot />

  <!-- Bootstrap JS bundle (con Popper). Usá la MISMA versión que el CSS -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>

  <!-- (Opcional) tu JS propio, después del bundle -->
  <script is:inline src="/js/main.js"></script>

  <!-- AOS  -->
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>
    AOS.init();
  </script>

  <script>
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        document.body.classList.add('tabbing');
      } else if (e.key === 'Escape') {
        document.body.classList.remove('tabbing');
      }
    });
    document.addEventListener('mousedown', () => {
      document.body.classList.remove('tabbing');
    });
  </script>

</body>

</html>
