---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  /** Slug de la página actual sin locale, ej. "" para Home, "areas" para Áreas de práctica */
  path?: string;
}

const { path = "" } = Astro.props;

const currentLocale = Astro.currentLocale ?? "es";
const isEn = currentLocale === "en";

const homeUrl = getRelativeLocaleUrl(currentLocale, "");
const areasUrl = getRelativeLocaleUrl(currentLocale, "areas");
const teamUrl = getRelativeLocaleUrl(currentLocale, "equipo");
const publicationsUrl = getRelativeLocaleUrl(currentLocale, "publicaciones");
const contactUrl = getRelativeLocaleUrl(currentLocale, "contacto");
const esUrl = getRelativeLocaleUrl("es", path);
const enUrl = getRelativeLocaleUrl("en", path);

const t = isEn
  ? {
      logoAlt: "Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Law Firm",
      team: "Our Team",
      areas: "Practice Areas",
      publications: "Publications",
      contact: "Contact us",
      bottomHome: "Home",
      bottomTeam: "Team",
      bottomAreas: "Areas",
      bottomPublications: "Publications",
      bottomContact: "Contact",
    }
  : {
      logoAlt: "Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Abogados",
      team: "Nuestro equipo",
      areas: "Áreas de práctica",
      publications: "Publicaciones",
      contact: "Contacto",
      bottomHome: "Inicio",
      bottomTeam: "Equipo",
      bottomAreas: "Áreas",
      bottomPublications: "Publicaciones",
      bottomContact: "Contacto",
    };
---

<!-- === NAVBAR === -->
<nav class="navbar navbar-expand-lg fixed-top custom-navbar shadow-sm px-custom">
  <div class="container-fluid align-items-center justify-content-between">
    <a class="navbar-brand" href={homeUrl}>
      <img src="/images/brvscu.png" alt={t.logoAlt} />
    </a>

    <ul class="navbar-nav ms-auto d-none d-lg-flex">
      <li class="nav-item px-2"><a class="nav-link" href={teamUrl}>{t.team}</a></li>
      <li class="nav-item px-2"><a class="nav-link" href={areasUrl}>{t.areas}</a></li>
      <li class="nav-item px-2"><a class="nav-link" href={publicationsUrl}>{t.publications}</a></li>
      <li class="nav-item px-2"><a class="nav-link" href={contactUrl}>{t.contact}</a></li>

      <li class="nav-item dropdown px-2">
        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          🌐 {isEn ? "EN" : "ES"}
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
          <li><a class="dropdown-item" href={esUrl}>Español</a></li>
          <li><a class="dropdown-item" href={enUrl}>English</a></li>
        </ul>
      </li>
    </ul>

    <div class="dropdown d-lg-none nav-lang-mobile">
      <button class="nav-lang-mobile__btn" type="button" id="languageDropdownMobile" data-bs-toggle="dropdown" aria-expanded="false" aria-label={isEn ? "Change language" : "Cambiar idioma"}>
        🌐 {isEn ? "EN" : "ES"}
      </button>
      <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdownMobile">
        <li><a class="dropdown-item" href={esUrl}>Español</a></li>
        <li><a class="dropdown-item" href={enUrl}>English</a></li>
      </ul>
    </div>
  </div>
</nav>

<nav class="bottom-nav d-lg-none" aria-label={isEn ? "Main navigation" : "Navegación principal"}>
  <a href={homeUrl} class={`bottom-nav__item ${path === "" ? "is-active" : ""}`}>
    <i class="bi bi-house-door-fill"></i>
    <span>{t.bottomHome}</span>
  </a>
  <a href={teamUrl} class={`bottom-nav__item ${path === "equipo" ? "is-active" : ""}`}>
    <i class="bi bi-people-fill"></i>
    <span>{t.bottomTeam}</span>
  </a>
  <a href={areasUrl} class={`bottom-nav__item ${path === "areas" ? "is-active" : ""}`}>
    <i class="bi bi-briefcase-fill"></i>
    <span>{t.bottomAreas}</span>
  </a>
  <a href={publicationsUrl} class={`bottom-nav__item ${path === "publicaciones" ? "is-active" : ""}`}>
    <i class="bi bi-newspaper"></i>
    <span>{t.bottomPublications}</span>
  </a>
  <a href={contactUrl} class={`bottom-nav__item ${path === "contacto" ? "is-active" : ""}`}>
    <i class="bi bi-envelope-fill"></i>
    <span>{t.bottomContact}</span>
  </a>
</nav>
