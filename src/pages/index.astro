---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Abogados" path="">
  <Nav path="" />

  <main>
    <!-- HERO -->
    <section id="hero" class="hero-static">
      <!-- Imagen de fondo -->
      <div class="hero-bg"></div>

      <!-- Capa oscura para contraste -->
      <div class="hero-overlay"></div>

      <!-- Contenido principal -->
      <div class="container-fluid h-100 d-flex align-items-center justify-content-center px-custom mt-5">
        <div class="hero-copy">
          <h1 class="hero-title mb-4">BRVSCU Abogados</h1>
          <p class="hero-subtitle mb-4">
            Profesionales que combinan prestigio, trayectoria judicial, conocimiento práctico y entusiasmo.
          </p>

        </div>
      </div>

      <!-- Indicador de scroll hacia la siguiente sección -->
      <a href="#estudio" class="hero-scroll-indicator" aria-label="Desplazarse a la siguiente sección">
        <i class="bi bi-chevron-down"></i>
      </a>
    </section>

    <!-- === EL ESTUDIO === -->
    <section id="estudio" class="estudio">
      <!-- Fila superior: texto + botón -->
      <div class="container px-custom">
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <h2 class="section-title">El Estudio</h2>
            <p class="section-intro mb-4">
              En <strong>BRVSCU</strong> asesoramos a empresas e instituciones en las principales áreas del derecho,
              combinando <strong>experiencia</strong> técnica, <strong>visión</strong> estratégica y compromiso con los resultados.
            </p>

            <p class="section-intro">
              Con más de 10 años de <strong>trayectoria</strong>, nuestro equipo de <strong>profesionales</strong> combinan trayectoria judicial, conocimiento práctico y entusiasmo para brindar soluciones legales integrales,
              acompañando los desafíos más complejos con ética, precisión y cercanía.
            </p>

            <a href="equipo.html" class="link-cta">Conocer al equipo <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>

        <!-- Fila inferior: imagen con efecto de aparición -->
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <figure class="estudio-img-wrapper">
              <img src="/images/grupal.jpg" class="img-fluid" alt="De izq. a der.: Agustín Medrano, Emilio Rojo Vivot, Lucía Rojo Vivot, Germán Silvero, Rómulo Rojo Vivot, Sebastián Eduardo Torres, Francisco Berdaguer, Francisco Diego Uriburu, Carolina Canziani Aguilar y Julio Quinto Benites" loading="lazy" decoding="async">
            </figure>
          </div>
        </div>
        <div>
          <p class="caption">De izq. a der.: Agustín Medrano, Emilio Rojo Vivot, Lucía Rojo Vivot, Germán Silvero, Rómulo Rojo Vivot, Sebastián Eduardo Torres, Francisco Berdaguer, Francisco Diego Uriburu, Carolina Canziani Aguilar y Julio Quinto Benites</p>
        </div>
      </div>
    </section>

    <!-- === ÁREAS DE PRÁCTICA === -->
    <section id="areas" class="mt-3 py-5 align-items-center">
      <div class="container  px-custom"  >
        <div class="row align-items-center flex-md-row py-5 mb-1" data-aos="fade-up" data-aos-duration="1000">
          <!-- Texto  -->
          <div class="col-12">
            <h2 class="section-title mb-4">Áreas de práctica</h2>
            <p >
              En <strong>BRVSCU</strong> brindamos asesoramiento integral en las principales ramas del <strong>derecho empresarial, civil, comercial, laboral y administrativo.</strong>.
            </p>
              <p  > Nuestro equipo de <strong>especialistas</strong> interviene en operaciones complejas, litigios, reestructuraciones, contrataciones, defensa de la competencia,
                seguros, agronegocios y derecho del deporte.
              </p>
              <p >  A través de una práctica interdisciplinaria, acompañamos a <strong>empresas y personas</strong> con <strong>soluciones jurídicas</strong> sólidas, estratégicas y ajustadas a cada necesidad.
              </p>
          </div>

          <div>
            <a href="areas.html" class="link-cta">Ver todas las áreas <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- === ÚLTIMAS PUBLICACIONES === -->
    <section id="ultimas-publicaciones">
      <div class="container px-custom" data-aos="fade-up" data-aos-duration="1000">
        <h2 class="section-title">Últimas publicaciones</h2>

        <div class="row g-4 gap-component">

          <!-- CARD 1 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0 shadow-sm">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Planificación sucesoria a través del fideicomiso testamentario</h5>
                <p class="card-meta">
                  <span>Rómulo Rojo Vivot</span>
                  <span>Diario La Ley - Thomson Reuters Argentina</span>
                  <span>10/09/2025</span>
                </p>
                <a href="/pdf/2025_rrv_planificacion_sucesoria.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0 shadow-sm">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">La cesión de derechos hereditarios como instrumento de planificación sucesoria</h5>
                <p class="card-meta">
                  <span>Rómulo Rojo Vivot</span>
                  <span>Diario La Ley - Thomson Reuters Argentina</span>
                  <span>23/07/2025</span>
                </p>
                <a href="/pdf/2025_rrv_cesion_derechos_hereditarios.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 3 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0 shadow-sm">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Donación. Planificación sucesoria a través de la división de bienes entre padres e hijos</h5>
                <p class="card-meta">
                  <span>Rómulo Rojo Vivot</span>
                  <span>Diario La Ley de Thomson Reuters Argentina</span>
                  <span>31/03/2025</span>
                </p>
                <a href="/pdf/2025_rrv_donacion.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

        </div>

        <a href="/publicaciones" class="link-cta">Ver todas las publicaciones <i class="bi bi-arrow-right"></i></a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
