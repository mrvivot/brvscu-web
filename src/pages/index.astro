---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="BRVSCU Abogados | Estudio Jurídico en Buenos Aires" description="Estudio jurídico en Buenos Aires. Asesoramiento integral en derecho empresarial, civil, comercial, laboral y administrativo. Más de 10 años de trayectoria." path="">
  <Nav path="" />

  <main id="main-content" tabindex="-1">
    <!-- HERO -->
    <section id="hero" class="hero-static">
      <!-- Imagen de fondo -->
      <div class="hero-bg"></div>

      <!-- Capa oscura para contraste -->
      <div class="hero-overlay"></div>

      <!-- Contenido principal -->
      <div class="container-fluid h-100 d-flex align-items-center justify-content-center px-custom mt-5">
        <div class="hero-copy">
          <h1 class="hero-title mb-4">BRVSCU Abogados</h1>
          <p class="hero-subtitle mb-4">
            Profesionales que combinan prestigio, trayectoria judicial, conocimiento práctico y entusiasmo.
          </p>

        </div>
      </div>

      <!-- Indicador de scroll hacia la siguiente sección -->
      <a href="#estudio" class="hero-scroll-indicator" aria-label="Desplazarse a la siguiente sección">
        <i class="bi bi-chevron-down"></i>
      </a>
    </section>

    <!-- === EL ESTUDIO === -->
    <section id="estudio" class="estudio">
      <!-- Fila superior: texto + botón -->
      <div class="container px-custom">
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <h2 class="section-title">El Estudio</h2>
            <p class="section-intro mb-4">
              En <strong>BRVSCU</strong> asesoramos a empresas e instituciones en las principales áreas del derecho,
              combinando experiencia técnica, visión estratégica y compromiso con los resultados.
            </p>

            <p class="section-intro">
              Con más de <strong>10 años de trayectoria</strong>, nuestro equipo combina formación técnica y sensibilidad estratégica para brindar soluciones legales integrales,
              acompañando los desafíos más complejos con ética, precisión y cercanía.
            </p>

            <a href="/equipo" class="link-cta">Conocer al equipo <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>

        <!-- Fila inferior: imagen con efecto de aparición -->
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <figure class="estudio-img-wrapper">
              <img src="/images/todos.jpg" class="img-fluid" alt="De izq. a der.: Agustín Medrano, Sebastián Eduardo Torres, Emilio Rojo Vivot, Francisco Diego Uriburu, Carolina Canziani Aguilar, Francisco Berdaguer, Rómulo Rojo Vivot, Germán Silvero, Lucía Rojo Vivot y Julio Quinto Benites" loading="lazy" decoding="async">
            </figure>
          </div>
        </div>
        <div>
          <p class="caption">De izq. a der.: Agustín Medrano, Sebastián Eduardo Torres, Emilio Rojo Vivot, Francisco Diego Uriburu, Carolina Canziani Aguilar, Francisco Berdaguer, Rómulo Rojo Vivot, Germán Silvero, Lucía Rojo Vivot y Julio Quinto Benites</p>
        </div>
      </div>
    </section>

    <!-- === ÁREAS DE PRÁCTICA === -->
    <section id="areas" class="mt-3 py-5 align-items-center">
      <div class="container  px-custom"  >
        <div class="row align-items-center flex-md-row py-5 mb-1" data-aos="fade-up" data-aos-duration="1000">
          <!-- Texto  -->
          <div class="col-12">
            <h2 class="section-title mb-4">Áreas de práctica</h2>
            <p>
              En <strong>BRVSCU</strong> brindamos asesoramiento integral en las principales ramas del derecho empresarial, civil, comercial, laboral y administrativo.
            </p>
            <p>
              Nuestro equipo de especialistas interviene en operaciones complejas, <strong>litigios</strong>, <strong>reestructuraciones</strong>, contrataciones, <strong>defensa de la competencia</strong>, seguros, agronegocios y derecho del deporte.
            </p>
            <p>
              A través de una práctica interdisciplinaria, acompañamos a empresas y personas con soluciones jurídicas sólidas, estratégicas y ajustadas a cada necesidad.
            </p>
          </div>

          <div>
            <a href="/areas" class="link-cta">Ver todas las áreas <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- === ÚLTIMAS PUBLICACIONES === -->
    <section id="ultimas-publicaciones">
      <div class="container px-custom" data-aos="fade-up" data-aos-duration="1000">
        <h2 class="section-title">Últimas publicaciones</h2>

        <div class="row g-4 gap-component">

          <!-- CARD 1 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Planificación sucesoria a través del fideicomiso testamentario</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> Diario La Ley - Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 10/09/2025</span>
                </p>
                <a href="/pdf/2025_rrv_planificacion_sucesoria.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">La cesión de derechos hereditarios como instrumento de planificación sucesoria</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> Diario La Ley - Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 23/07/2025</span>
                </p>
                <a href="/pdf/2025_rrv_cesion_derechos_hereditarios.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 3 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Donación. Planificación sucesoria a través de la división de bienes entre padres e hijos</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> Diario La Ley de Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 31/03/2025</span>
                </p>
                <a href="/pdf/2025_rrv_donacion.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Leer artículo
             </a>
              </div>
            </div>
          </div>

        </div>

        <a href="/publicaciones" class="link-cta">Ver todas las publicaciones <i class="bi bi-arrow-right"></i></a>
      </div>
    </section>

    <!-- BANDA CTA INFERIOR -->
    <section class="band-cta band-cta--stacked" aria-labelledby="bandCtaTitle">
      <div class="container px-custom">
        <div class="band-cta__inner">
          <h3 id="bandCtaTitle" class="band-cta__title">
            Soluciones legales integrales,<span> en todo el país.</span>
          </h3>
          <!-- Usá tu componente de botón reutilizable -->
          <a href="/contacto" class="btn-cta">Contactanos</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
