---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Abogados" path="">
  <Nav path="" />

  <main>
    <!-- HERO -->
    <section id="hero" class="hero-static">
      <!-- Imagen de fondo -->
      <div class="hero-bg"></div>

      <!-- Capa oscura para contraste -->
      <div class="hero-overlay"></div>

      <!-- Contenido principal -->
      <div class="container-fluid h-100 d-flex align-items-center px-custom mt-5">
        <div class="hero-copy">
          <h1 class="hero-title mb-3">BRVSCU Abogados</h1>
          <p class="hero-subtitle mb-4">
            Profesionales que combinan prestigio, trayectoria judicial, conocimiento práctico y entusiasmo.
          </p>

        </div>
      </div>
    </section>

    <!-- BANDA CTA INFERIOR -->
    <section class="band-cta  text-bg-dark" aria-labelledby="bandCtaTitle">
      <div class="container px-custom">
        <div class="band-cta__inner">
          <h3 id="bandCtaTitle" class="band-cta__title">
            Soluciones legales integrales,<span> en todo el país.</span>
          </h3>
          <!-- Usá tu componente de botón reutilizable -->
          <a href="contacto.html" class="btn-cta">Contactanos</a>
        </div>
      </div>
    </section>

    <!-- === EL ESTUDIO === -->
    <section id="estudio" class="estudio">
      <!-- Fila superior: texto + botón -->
      <div class="container px-custom mt-5">
        <div class="row mt-3 py-5" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <h2 class="section-title mb-4">El Estudio</h2>
            <p class="section-intro mb-4">
              En <strong>BRVSCU</strong> asesoramos a empresas e instituciones en las principales áreas del derecho,
              combinando <strong>experiencia</strong> técnica, <strong>visión</strong> estratégica y compromiso con los resultados.
            </p>

            <p class="section-intro mb-2">
              Con más de 10 años de <strong>trayectoria</strong>, nuestro equipo de <strong>profesionales</strong> combinan trayectoria judicial, conocimiento práctico y entusiasmo para brindar soluciones legales integrales,
              acompañando los desafíos más complejos con ética, precisión y cercanía.
            </p>

            <a href="equipo.html" class="btn-cta">Conocer al equipo</a>
          </div>
        </div>

        <!-- Fila inferior: imagen con efecto de aparición -->
        <div class="row mt-5" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <figure class="estudio-img-wrapper">
              <img src="/images/todos.jpg" class="img-fluid rounded" alt="De izq. a der.: Agustín Medrano, Sebastián Eduardo Torres, Emilio Rojo Vivot, Francisco Diego Uriburu, Carolina Canziani Aguilar, Francisco Berdaguer, Rómulo Rojo Vivot, Germán Silvero, Lucía Rojo Vivot y Julio Quinto Benites" loading="lazy" decoding="async">
            </figure>
          </div>
        </div>
        <div>
          <p class="caption">De izq. a der.: Agustín Medrano, Sebastián Eduardo Torres, Emilio Rojo Vivot, Francisco Diego Uriburu, Carolina Canziani Aguilar, Francisco Berdaguer, Rómulo Rojo Vivot, Germán Silvero, Lucía Rojo Vivot y Julio Quinto Benites</p>
        </div>
      </div>
    </section>

    <!-- === ÁREAS DE PRÁCTICA === -->
    <section id="areas" class="mt-3 py-5 align-items-center bg-light">
      <div class="container  px-custom"  >
        <div class="row align-items-center flex-md-row py-5 mb-1" data-aos="fade-up" data-aos-duration="1000">
          <!-- Texto  -->
          <div class="col-12">
            <h2 class="section-title mb-4">Áreas de práctica</h2>
            <p >
              En <strong>BRVSCU</strong> brindamos asesoramiento integral en las principales ramas del <strong>derecho empresarial, civil, comercial, laboral y administrativo.</strong>.
            </p>
              <p  > Nuestro equipo de <strong>especialistas</strong> interviene en operaciones complejas, litigios, reestructuraciones, contrataciones, defensa de la competencia,
                seguros, agronegocios y derecho del deporte.
              </p>
              <p >  A través de una práctica interdisciplinaria, acompañamos a <strong>empresas y personas</strong> con <strong>soluciones jurídicas</strong> sólidas, estratégicas y ajustadas a cada necesidad.
              </p>
          </div>

          <div>
            <a href="areas.html" class="btn-cta ">Ver todas las áreas</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
