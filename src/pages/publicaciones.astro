---
import Layout from "../components/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Publicaciones | BRVSCU Abogados" description="Artículos y análisis legales de los abogados de BRVSCU sobre planificación sucesoria, derecho concursal, societario y más." path="publicaciones">
  <Nav path="publicaciones" />

  <main id="main-content" tabindex="-1">
    <section id="publicaciones" class="publicaciones">
        <div class="container mt-5 px-custom" data-aos="fade-up" data-aos-duration="1000" >
          <div class="row mt-5 py-5">
            <div class="col-12">
              <h1 class="section-title mb-4">Publicaciones</h1>
              <p class="section-intro mb-4">
                En BRVSCU compartimos análisis, artículos y reflexiones sobre actualidad jurídica, doctrina y práctica profesional. Nuestro objetivo es aportar una mirada técnica y responsable sobre los temas que impactan en el ejercicio del derecho y en la actividad empresarial.
              </p>
            </div>
          </div>
        </div>

        <!-- GRID DE PUBLICACIONES -->
        <div class="container px-custom pb-5" data-aos="fade-up" data-aos-duration="1000">
          <div class="row g-4">

            <!-- CARD 1 -->
            <div class="col-sm-6 col-md-4">
              <div class="card card-publicacion h-100 border-0">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">Planificación sucesoria a través del fideicomiso testamentario</h5>
                  <p class="card-meta">
                    <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                    <span><i class="bi bi-newspaper"></i> Diario La Ley - Thomson Reuters Argentina</span>
                    <span><i class="bi bi-calendar-event-fill"></i> 10/09/2025</span>
                  </p>
                  <a href="/pdf/2025_rrv_planificacion_sucesoria.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-cta-plain">
                 Leer artículo
               </a>
                </div>
              </div>
            </div>

            <!-- CARD 2 -->
            <div class="col-sm-6 col-md-4">
              <div class="card card-publicacion h-100 border-0">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">La cesión de derechos hereditarios como instrumento de planificación sucesoria</h5>
                  <p class="card-meta">
                    <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                    <span><i class="bi bi-newspaper"></i> Diario La Ley - Thomson Reuters Argentina</span>
                    <span><i class="bi bi-calendar-event-fill"></i> 23/07/2025</span>
                  </p>
                  <a href="/pdf/2025_rrv_cesion_derechos_hereditarios.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-cta-plain">
                 Leer artículo
               </a>
                </div>
              </div>
            </div>

            <!-- CARD 3 -->
            <div class="col-sm-6 col-md-4">
              <div class="card card-publicacion h-100 border-0">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title">Donación. Planificación sucesoria a través de la división de bienes entre padres e hijos</h5>
                  <p class="card-meta">
                    <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                    <span><i class="bi bi-newspaper"></i> Diario La Ley de Thomson Reuters Argentina</span>
                    <span><i class="bi bi-calendar-event-fill"></i> 31/03/2025</span>
