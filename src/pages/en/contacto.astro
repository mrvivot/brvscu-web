---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Law Firm" path="contacto">
  <Nav path="contacto" />

  <main>
    <!-- === CONTACT === -->
    <section id="contact" class="contacto-section text-white">
      <div class="container px-custom py-5">
        <h2 class="section-title text-white my-5 pt-5">Contact</h2>

        <div class="row">
          <!-- Info -->
          <div class="col-md-7 contacto-info mb-4 mb-md-0">
            <ul class="list-unstyled contacto-list">

              <li class="mb-3 d-flex align-items-start">
                <i class="bi bi-telephone-fill me-3 contacto-icon" aria-hidden="true"></i>
                <div>
                  <strong>Phone:</strong><br>
                  (+54 11) 4519 8173
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <i class="bi bi-envelope-fill me-3 contacto-icon" aria-hidden="true"></i>
                <div>
                  <strong>Email:</strong><br>
                  <a class="contacto-link" href="mailto:secretaria@brvscu.com.ar">secretaria@brvscu.com.ar</a>
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <i class="bi bi-geo-alt-fill me-3 contacto-icon" aria-hidden="true"></i>
                <div>
                  <strong>Address:</strong><br>
                  Av. Santa Fe 1752, 1º A – Buenos Aires City (C1060ABQ)
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <i class="bi bi-clock me-3 contacto-icon" aria-hidden="true"></i>
                <div>
                  <strong>Office hours:</strong><br>
                  Monday to Friday, 8 a.m. – 6 p.m.
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <i class="bi bi-linkedin me-3 contacto-icon" aria-hidden="true"></i>
                <a class="contacto-link" href="https://www.linkedin.com/company/berdaguer-rojo-vivot-silvero-canziani-uriburu-abogados/posts/?feedView=all" target="_blank" rel="noopener noreferrer">
                  <strong>Follow us on LinkedIn</strong>
                </a>
              </li>
            </ul>
          </div>

          <!-- Map -->
          <div class="col-md-5">
            <div class="map-container">
              <iframe
                title="BRVSCU Location"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3282.9223933652873!2d-58.392678624865396!3d-34.63056235896819!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccad7c3f44fd3%3A0x91f58c839244b923!2sAv.%20Santa%20Fe%201752%2C%20C1060ABQ%20CABA!5e0!3m2!1sen!2sar!4v1715601429996!5m2!1sen!2sar"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen>
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
