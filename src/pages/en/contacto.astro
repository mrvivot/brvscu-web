---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Contact | BRVSCU Law Firm" description="Get in touch with BRVSCU Law Firm. Avda. Santa Fe 1752, Buenos Aires. Phone, email, and office location." path="contacto">
  <Nav path="contacto" />

  <main>
    <!-- === CONTACT === -->
    <section id="contact" class="contacto-section">
      <div class="container px-custom py-5">
        <h1 class="section-title my-5 pt-5">Contact</h1>

        <div class="row">
          <!-- Info -->
          <div class="col-md-7 contacto-info mb-4 mb-md-0">
            <ul class="list-unstyled contacto-list">

              <li class="mb-3 d-flex align-items-start">
                <svg class="contacto-icon me-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.68 1.6l-.468.339a1 1 0 0 0-.288 1.24 12 12 0 0 0 6.26 6.245z" />
                </svg>
                <div>
                  <strong>Phone:</strong><br>
                  (+54 11) 4519 8173
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <svg class="contacto-icon me-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                </svg>
                <div>
                  <strong>Email:</strong><br>
                  <a class="contacto-link" href="mailto:secretaria@brvscu.com.ar">secretaria@brvscu.com.ar</a>
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <svg class="contacto-icon me-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <div>
                  <strong>Address:</strong><br>
                  Av. Santa Fe 1752, 1º A – Buenos Aires City (C1060ABQ)
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <svg class="contacto-icon me-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 6v6l4 2" />
                  <circle cx="12" cy="12" r="10" />
                </svg>
                <div>
                  <strong>Office hours:</strong><br>
                  Monday to Friday, 8 a.m. – 6 p.m.
                </div>
              </li>

              <li class="mb-3 d-flex align-items-start">
                <svg class="contacto-icon me-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect width="4" height="12" x="2" y="9" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
                <a class="contacto-link" href="https://www.linkedin.com/company/berdaguer-rojo-vivot-silvero-canziani-uriburu-abogados/posts/?feedView=all" target="_blank" rel="noopener noreferrer">
                  <strong>Follow us on LinkedIn</strong>
                </a>
              </li>
            </ul>
          </div>

          <!-- Map -->
          <div class="col-md-5">
            <div class="map-container">
              <iframe
                title="BRVSCU Location"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3282.9223933652873!2d-58.392678624865396!3d-34.63056235896819!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccad7c3f44fd3%3A0x91f58c839244b923!2sAv.%20Santa%20Fe%201752%2C%20C1060ABQ%20CABA!5e0!3m2!1sen!2sar!4v1715601429996!5m2!1sen!2sar"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen>
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
