---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Berdaguer | Rojo Vivot | Silvero | Canziani | Uriburu - Law Firm" path="equipo">
  <Nav path="equipo" />

  <main>
    <!-- TEAM -->
    <section id="estudio" class="estudio">
      <div class="container mt-5 px-custom" data-aos="fade-up" data-aos-duration="1000">
        <div class="row mt-5 py-5">
          <div class="col-12">
            <h2 class="section-title mb-4">Our Team</h2>
            <p class="section-intro mb-4">
              Our team is made up of professionals with outstanding experience in different areas of law.
              Each of our partners contributes a solid academic background, experience in key sectors, and a strategic approach
              to provide efficient, comprehensive, and tailored legal solutions. Discover their careers and areas of expertise.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!--CARDS-->
    <section id="socios" class="py-3 my-3 px-custom">
      <div class="container">
        <div class="row g-4 pb-5">

          <!-- BERDAGUER -->
          <div class="col-sm-6 col-md-4 col-lg-3" data-aos="fade-up" data-aos-duration="600" data-aos-delay="0">
            <div class="card card-socio h-100 border-0">
