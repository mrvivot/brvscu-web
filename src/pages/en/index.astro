---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="BRVSCU Law Firm | Attorneys in Buenos Aires" description="Law firm in Buenos Aires with over 10 years of experience. Comprehensive legal counsel in corporate, civil, commercial, and labor law." path="">
  <Nav path="" />

  <main id="main-content" tabindex="-1">
    <!-- HERO -->
    <section id="hero" class="hero-static">
      <!-- Background image -->
      <div class="hero-bg"></div>

      <!-- Dark overlay for contrast -->
      <div class="hero-overlay"></div>

      <!-- Main content -->
      <div class="container-fluid h-100 d-flex align-items-center justify-content-center px-custom mt-5">
        <div class="hero-copy">
          <h1 class="hero-title mb-4">BRVSCU Law Firm</h1>
          <p class="hero-subtitle mb-4">
            Professionals who combine prestige, judicial experience, practical know-how and enthusiasm.
          </p>

        </div>
      </div>

      <!-- Scroll indicator to next section -->
      <a href="#firm" class="hero-scroll-indicator" aria-label="Scroll to next section">
        <i class="bi bi-chevron-down"></i>
      </a>
    </section>

    <!-- === THE FIRM === -->
    <section id="firm" class="estudio">
      <!-- Upper row: text + button -->
      <div class="container px-custom">
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <h2 class="section-title">The Firm</h2>
            <p class="section-intro mb-4">
              At <strong>BRVSCU</strong>, we advise companies and institutions in the main areas of law,
              combining technical <strong>expertise</strong>, strategic <strong>vision</strong> and a strong commitment to results.
            </p>

            <p class="section-intro">
              With over 10 years of <strong>experience</strong>, our team of <strong>professionals</strong> provides comprehensive legal solutions,
              addressing complex challenges with <strong>ethics</strong>, <strong>precision</strong> and <strong>proximity</strong>.
            </p>

            <a href="/en/equipo" class="link-cta">Meet the team <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>

        <!-- Lower row: image with fade-in effect -->
        <div class="row" data-aos="fade-up" data-aos-duration="1000">
          <div class="col-12">
            <figure class="estudio-img-wrapper">
              <img src="/images/grupal.jpg" class="img-fluid" alt="From left to right: Agustín Medrano, Emilio Rojo Vivot, Lucía Rojo Vivot, Germán Silvero, Rómulo Rojo Vivot, Sebastián Eduardo Torres, Francisco Berdaguer, Francisco Diego Uriburu, Carolina Canziani Aguilar and Julio Quinto Benites" loading="lazy" decoding="async">
            </figure>
          </div>
        </div>
        <div>
          <p class="caption">From left to right: Agustín Medrano, Emilio Rojo Vivot, Lucía Rojo Vivot, Germán Silvero, Rómulo Rojo Vivot, Sebastián Eduardo Torres, Francisco Berdaguer, Francisco Diego Uriburu, Carolina Canziani Aguilar and Julio Quinto Benites</p>
        </div>
      </div>
    </section>

    <!-- === PRACTICE AREAS === -->
    <section id="areas" class="mt-3 py-5 align-items-center">
      <div class="container  px-custom"  >
        <div class="row align-items-center flex-md-row py-5 mb-1" data-aos="fade-up" data-aos-duration="1000">
          <!-- Text -->
          <div class="col-12">
            <h2 class="section-title mb-4">Practice Areas</h2>
            <p>
              At <strong>BRVSCU</strong>, we provide comprehensive legal counsel across the main branches of
              <strong>corporate, civil, commercial, labor, and criminal law</strong>.
            </p>
            <p>
              Our team of <strong>specialists</strong> handles complex transactions, litigation, restructurings,
              contracts, competition and consumer defense, insurance, agribusiness, and sports law.
            </p>
            <p>
              Through an <strong>interdisciplinary approach</strong>, we assist <strong>companies and individuals</strong> with
              <strong>sound, strategic, and tailored legal solutions</strong> that meet every client’s needs.
            </p>
          </div>

          <div>
            <a href="/en/areas" class="link-cta">See all practice areas <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- === LATEST PUBLICATIONS === -->
    <section id="ultimas-publicaciones">
      <div class="container px-custom" data-aos="fade-up" data-aos-duration="1000">
        <h2 class="section-title">Latest Publications</h2>

        <div class="row g-4 gap-component">

          <!-- CARD 1 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Estate Planning Through Testamentary Trusts</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> La Ley – Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 09/10/2025</span>
                </p>
                <a href="/pdf/2025_rrv_planificacion_sucesoria.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Read article
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Assignment of Inheritance Rights as an Estate Planning Tool</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> La Ley – Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 07/23/2025</span>
                </p>
                <a href="/pdf/2025_rrv_cesion_derechos_hereditarios.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Read article
             </a>
              </div>
            </div>
          </div>

          <!-- CARD 3 -->
          <div class="col-sm-6 col-md-4">
            <div class="card card-publicacion h-100 border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">Donations: Estate Planning Through the Division of Assets Between Parents and Children</h5>
                <p class="card-meta">
                  <span><i class="bi bi-person-fill"></i> Rómulo Rojo Vivot</span>
                  <span><i class="bi bi-newspaper"></i> La Ley – Thomson Reuters Argentina</span>
                  <span><i class="bi bi-calendar-event-fill"></i> 03/31/2025</span>
                </p>
                <a href="/pdf/2025_rrv_donacion.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="card-cta-plain">
               Read article
             </a>
              </div>
            </div>
          </div>

        </div>

        <a href="/en/publicaciones" class="link-cta">See all publications <i class="bi bi-arrow-right"></i></a>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="band-cta band-cta--stacked" aria-labelledby="bandCtaTitle">
      <div class="container px-custom">
        <div class="band-cta__inner">
          <h3 id="bandCtaTitle" class="band-cta__title">
            Comprehensive legal solutions,<span> nationwide.</span>
          </h3>
          <!-- Reusable CTA button component -->
          <a href="/en/contacto" class="btn-cta">Let’s talk</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
