---
import Layout from "../../components/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Publications | BRVSCU Law Firm" description="Legal articles and analysis by BRVSCU attorneys on estate planning, insolvency law, corporate law, and more." path="publicaciones">
  <Nav path="publicaciones" />

  <main>
    <section id="publicaciones" class="publicaciones">
      <div class="container mt-5 px-custom" data-aos="fade-up" data-aos-duration="1000">
        <div class="row mt-5 py-5">
          <div class="col-12">
            <h2 class="section-title mb-4">Publications</h2>
            <p class="section-intro mb-4">
              At BRVSCU we share analyses, articles, and reflections on legal developments, doctrine, and professional practice. Our goal is to offer a rigorous and responsible perspective on issues that impact the practice of law and business activity.
            </p>
          </div>
        </div>
      </div>

      <!-- GRID OF PUBLICATIONS -->
